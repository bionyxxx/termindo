# Copy to .env and fill in. Full guide: docs/deploy-vps.md

# Public hostname of the sync server, e.g. sync.example.com (DNS A record -> this VPS).
TERMINDO_DOMAIN=

# Generate with: openssl rand -base64 48
TERMINDO_JWT_SECRET=
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Set to false after creating your own account(s) so strangers can't register.
TERMINDO_ALLOW_REGISTRATION=true

# true when the server is only reached through Caddy (the tls profile), so rate
# limiting sees real client IPs from X-Forwarded-For. Keep false otherwise.
TERMINDO_TRUST_PROXY=true

# Server image (built by the "Server image" GitHub workflow). Pin a version tag such
# as ghcr.io/bionyxxx/termindo-server:0.1 to control upgrades.
TERMINDO_IMAGE=ghcr.io/bionyxxx/termindo-server:latest

# Loopback port of the server (only used by Caddy or a local reverse proxy).
TERMINDO_PORT=8080
# Public ports for Caddy.
HTTP_PORT=80
HTTPS_PORT=443

# Backups (pg_dump into ./backups): cron schedule and retention.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
