# Generate with: openssl rand -base64 48
TERMINDO_JWT_SECRET=
POSTGRES_PASSWORD=
# Set to false after creating your own account to close the server to strangers.
TERMINDO_ALLOW_REGISTRATION=true
# Set to true only when the server is reached exclusively through a reverse proxy (e.g. the tls profile).
TERMINDO_TRUST_PROXY=false
TERMINDO_PORT=8080
# Public hostname for the Caddy (tls) profile, e.g. sync.example.com
TERMINDO_DOMAIN=
